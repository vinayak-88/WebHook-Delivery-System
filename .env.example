PORT=3000
MONGODB_URI=mongodb://localhost:27017/webhook-delivery
REDIS_HOST=localhost
REDIS_PORT=6379
NODE_ENV=development

# Body size limit for incoming JSON requests (e.g. 16kb, 100kb, 1mb)
BODY_LIMIT=16kb

# AES-256-GCM encryption key for subscriber signing secrets at rest.
# Must be a 64-character hex string (32 bytes). Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admin API key for accessing /dead-letters inspection & replay.
# Pass via X-Admin-Api-Key header.
ADMIN_API_KEY=your-secure-admin-api-key-here

# Worker concurrency (number of concurrent delivery jobs processed per worker)
WORKER_CONCURRENCY=5

# Maximum random jitter added to exponential backoff delays (in milliseconds)
RETRY_JITTER_MS=500

# Global timeout for outbound webhook delivery requests (in milliseconds)
WEBHOOK_TIMEOUT_MS=5000

# Max subscriber response text kept per DeliveryLog record (in characters).
# Longer responses are truncated with a "...[truncated]" marker; audit only.
MAX_DELIVERY_RESPONSE_BODY_CHARS=8192

# Graceful shutdown maximum wait time before forced exit (in milliseconds)
SHUTDOWN_TIMEOUT_MS=10000

# Pending event recovery loop settings
RECOVERY_INTERVAL_MS=5000
RECOVERY_BATCH_SIZE=25
# Set to true on all but one API instance when running multiple replicas
DISABLE_RECOVERY=false

# Set to true only in development/test environments to allow deliveries to localhost/private IPs
DISABLE_SSRF_CHECK=false

# --- Local demo only (mock producer/subscriber on the host) -----------------
# Plaintext webhook signing secret shared by the mock subscriber (to verify
# HMAC) and the mock producer (to register with). This is NOT the server-side
# WEBHOOK_ENCRYPTION_KEY above — the two must not be confused. Min 32 chars.
WEBHOOK_SECRET=mock-shared-webhook-secret-at-least-32-chars-long!

# API base URL used by the mock producer
BASE_URL=http://localhost:3000

# URL the worker delivers to. Default works when API + worker run on the host.
# When API + worker run in Docker with mocks on the host, use:
# SUBSCRIBER_URL=http://host.docker.internal:4000/receive
SUBSCRIBER_URL=http://localhost:4000/receive
